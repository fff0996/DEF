Bootstrap: docker
From: python:3.13.15-slim-bookworm

%labels
    Pipeline RTpred
    Revision 2
    Module compare
    BaseOS Debian-12-bookworm
    Python 3.13.15
    PackageManager pip
    RuntimeNetworkRequired false

%files
    mdcc /opt/mdcc/mdcc
    containers/requirements.txt /opt/mdcc/requirements.txt
    models /opt/mdcc/models

%post
    set -eu
    apt-get update
    apt-get install -y --no-install-recommends libgomp1 libstdc++6 fonts-dejavu-core
    rm -rf /var/lib/apt/lists/*
    /usr/local/bin/python -m pip install --no-cache-dir -r /opt/mdcc/requirements.txt
    /usr/local/bin/python -m pip check
    /usr/local/bin/python -m pip freeze --all > /opt/mdcc/pip-freeze.txt
    dpkg-query -W > /opt/mdcc/os-packages.txt
    test ! -d /opt/conda
    if command -v conda; then exit 1; fi

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export PYTHONPATH=/opt/mdcc
    export PYTHONNOUSERSITE=1
    export PYTHONDONTWRITEBYTECODE=1
    export MPLBACKEND=Agg
    export MPLCONFIGDIR=/tmp/mdcc-matplotlib
    export OMP_NUM_THREADS=2
    export OPENBLAS_NUM_THREADS=2
    export MKL_NUM_THREADS=2
    export HF_HUB_OFFLINE=1
    export AWS_EC2_METADATA_DISABLED=true

%runscript
    exec /usr/local/bin/python -m mdcc.cli compare "$@"

%test
    export PYTHONPATH=/opt/mdcc
    export PYTHONDONTWRITEBYTECODE=1
    /usr/local/bin/python -c 'from mdcc.core import check_runtime; check_runtime(); from mdcc.core import load_model; [load_model("/opt/mdcc/models/"+m.lower()+"_model",m) for m in ("RP","HILIC")]'
    /usr/local/bin/python -m mdcc.cli compare --help
    if command -v conda; then exit 1; fi
