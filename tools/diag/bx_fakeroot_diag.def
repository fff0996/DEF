Bootstrap: docker
From: rockylinux/rockylinux@sha256:8101994123cf3d0a8fee517bee7f39e555c7d92bd2d9eb3303cc988a0eeed00f

# =============================================================================
# bx_fakeroot_diag (diagnostic only; do not register or deploy the SIF)
#
#   Same %post as bx_functional_enrichment.1.0.def, plus checkpoints that
#   record why the final workspace removal failed in the production
#   fakeroot-command build ("rm: cannot remove .../miniforge/pkgs: Is a
#   directory"). At each checkpoint it prints the fakeroot version and the
#   filesystem type, lists entries whose type differs between the directory
#   listing (kernel) and lstat (answered by fakeroot), and saves an inode list
#   of the root filesystem. Before the cleanup it reports, for every
#   mismatched path, what the same inode number was at earlier checkpoints.
#   Inode lists are kept in /opt/closha-diag inside the image.
#   Build it with the same production command as the other DEFs, then send
#   the build log; the SIF can be deleted.
# =============================================================================

%labels
    Maintainer       KOBIC Bio-Express
    Pipeline         ATAC-seq
    Component        bx_fakeroot_diag
    Version          1.0
    BaseOS           RockyLinux9
    CondaInstaller   Miniforge3-26.7.2-0
    AnacondaRepoFree true
    RVersion         4.5.3
    Description      "clusterProfiler GO enrichment environment for the CLOSHA ATAC-seq functional_enrichment script"

%environment
    export PATH=/opt/bio/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    # Keep host-side user R libraries and profiles out of this runtime.
    unset R_LIBS
    export R_LIBS_USER=/opt/bio/lib/R/library
    export R_PROFILE_USER=/dev/null
    export R_ENVIRON_USER=/dev/null

%post
    set -eu
    # Fixed container PATH; ignore any inherited PATH that may point into a
    # host-bound home directory.
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C.UTF-8

    # Apptainer builds keep the admin "mount tmp = yes" setting, so %post sees
    # the host /tmp and /var/tmp. Cover both with private tmpfs mounts in this
    # container's mount namespace before any other command runs; the host
    # directories are then unreachable. If mounting fails, the build stops.
    mount -t tmpfs -o mode=1777,nosuid,nodev closha-tmp /tmp
    mount -t tmpfs -o mode=1777,nosuid,nodev closha-vartmp /var/tmp
    [ "$(stat -f -c %T /tmp)" = tmpfs ] || { echo "/tmp is not private" >&2; exit 1; }
    [ "$(stat -f -c %T /var/tmp)" = tmpfs ] || { echo "/var/tmp is not private" >&2; exit 1; }
    # With "mount dev = yes" the build may see the host's /dev and its shared
    # /dev/shm. Cover /dev/shm with a private tmpfs as well, then confirm from
    # the mount table that the newest /dev/shm mount is this one.
    if [ -d /dev/shm ]; then
        mount -t tmpfs -o mode=1777,nosuid,nodev closha-shm /dev/shm
        awk '$5 == "/dev/shm" { s = $0 } END { exit !(s ~ / - tmpfs closha-shm /) }' /proc/self/mountinfo ||
            { echo "/dev/shm is not private" >&2; exit 1; }
    fi
    # Record the mount table in the build log for review.
    cat /proc/self/mountinfo

    # Stop before any install step if the build container has a mount other
    # than those Apptainer creates for builds: the rootfs, /tmp and /var/tmp
    # (now covered above), private /etc/hosts and /etc/resolv.conf copies, and
    # kernel pseudo-filesystems under /dev, /proc, and /sys, plus, in builds
    # that run %post under the fakeroot command (no /etc/subuid entry), the
    # read-only fakeroot helpers Apptainer places under /.singularity.d/libs.
    # This rejects host paths added through APPTAINER_BINDPATH or
    # APPTAINER_MOUNT, which the build passes into %post from the caller's
    # environment.
    awk '
        { split($0, sep, " - "); split(sep[2], f, " "); mp = $5; opt = $6; fs = f[1]; src = $4 }
        mp == "/" || mp == "/tmp" || mp == "/var/tmp" { next }
        (mp == "/etc/hosts" || mp == "/etc/resolv.conf") &&
            src ~ /\/bundle-temp-[0-9]+\/(hosts|resolv\.conf)$/ { next }
        (mp == "/dev" || mp ~ /^\/dev\//) && fs ~ /^(devtmpfs|tmpfs|devpts|mqueue|hugetlbfs)$/ { next }
        (mp == "/proc" || mp ~ /^\/proc\//) && fs ~ /^(proc|binfmt_misc|autofs)$/ { next }
        (mp == "/sys" || mp ~ /^\/sys\//) &&
            fs ~ /^(sysfs|cgroup|cgroup2|securityfs|selinuxfs|debugfs|tracefs|bpf|fusectl|configfs|pstore|efivarfs)$/ { next }
        mp == "/.singularity.d/libs" && fs == "tmpfs" && opt ~ /^ro(,|$)/ { next }
        mp ~ /^\/\.singularity\.d\/libs\/(fakeroot|faked|libfakeroot\.so)$/ && opt ~ /^ro(,|$)/ { next }
        { print "Unexpected mount in build container: " mp " (" fs ")" > "/dev/stderr"; bad = 1 }
        END { exit bad }
    ' /proc/self/mountinfo || { echo "Build stopped: remove extra bind settings and rebuild" >&2; exit 1; }

    fail() { echo "Build check failed: $*" >&2; exit 1; }

    # Diagnostic checkpoints (see the header).
    DIAG=/opt/closha-diag
    mkdir -p "$DIAG"
    checkpoint() {
        echo "==== DIAG checkpoint $1"
        ls -l /.singularity.d/libs 2>/dev/null || echo "no /.singularity.d/libs (not the fakeroot command)"
        if [ -e /.singularity.d/libs/fakeroot ]; then
            sh /.singularity.d/libs/fakeroot --version 2>&1 || true
        fi
        echo "LD_PRELOAD=${LD_PRELOAD:-<unset>}"
        echo "rootfs type: $(stat -f -c %T /)"
        /usr/bin/env python3 - "$1" "$DIAG" <<'PYDIAG' || true
import os, stat, sys
label, diag = sys.argv[1], sys.argv[2]
order = ["1_after_dnf", "2_before_miniforge", "3_after_miniforge", "4_after_conda_create", "5_before_cleanup"]
root_dev = os.lstat("/").st_dev
cur = {}
mism = []
for dirpath, dirs, files in os.walk("/"):
    # Stay on the root filesystem; skip the diagnostic output itself.
    dirs[:] = [d for d in dirs if os.lstat(os.path.join(dirpath, d)).st_dev == root_dev
               and os.path.join(dirpath, d) != diag]
    try:
        entries = list(os.scandir(dirpath))
    except OSError:
        continue
    for e in entries:
        kern = "d" if e.is_dir(follow_symlinks=False) else ("l" if e.is_symlink() else "f")
        try:
            m = os.lstat(e.path).st_mode
        except OSError:
            continue
        fake = "d" if stat.S_ISDIR(m) else ("l" if stat.S_ISLNK(m) else "f")
        cur[e.inode()] = (kern, e.path)
        if kern != fake:
            mism.append((e.path, e.inode(), kern, fake, m))
with open(os.path.join(diag, "inodes.%s.txt" % label), "w") as f:
    for ino in sorted(cur):
        f.write("%d %s %s\n" % (ino, cur[ino][0], cur[ino][1]))
print("DIAG %s: %d entries, %d mismatches (listing vs lstat)" % (label, len(cur), len(mism)))
for path, ino, kern, fake, m in mism[:50]:
    print("DIAG mismatch: %s inode=%d listing=%s lstat=%s mode=%o" % (path, ino, kern, fake, m))
# For each mismatch, what was this inode at earlier checkpoints?
for cp in order[:order.index(label)] if label in order else []:
    fn = os.path.join(diag, "inodes.%s.txt" % cp)
    if not os.path.exists(fn):
        continue
    old = {}
    with open(fn) as f:
        for line in f:
            ino, t, path = line.rstrip("\n").split(" ", 2)
            old[int(ino)] = (t, path)
    for path, ino, kern, fake, m in mism[:50]:
        if ino in old:
            print("DIAG history: inode %d (%s now) was %s %s at %s" % (ino, path, old[ino][0], old[ino][1], cp))
PYDIAG
    }

    # Fixed container-private workspace from the approved profile.
    # Plain mkdir (no -p) fails if a path already exists, including a symlink
    # or a bind mount point, so the build stops instead of reusing it.
    BUILD_ROOT=/__closha_build
    WORK=/__closha_build/work
    mkdir -m 0700 -- "$BUILD_ROOT"
    mkdir -m 0700 -- "$WORK"
    mkdir -p -- "$WORK/src" "$WORK/tmp" "$WORK/home" "$WORK/conda-pkgs" "$WORK/dnf-cache"

    # The admin config may bind the host home, and /tmp may be host-backed.
    # Redirect HOME, TMPDIR, and XDG directories into the workspace before any
    # other command runs, so no tool reads or writes host user files or /tmp.
    export HOME="$WORK/home"
    export TMPDIR="$WORK/tmp"
    export XDG_CACHE_HOME="$WORK/home/.cache"
    export XDG_CONFIG_HOME="$WORK/home/.config"
    export XDG_DATA_HOME="$WORK/home/.local/share"

    # The pinned conda packages below are for linux-64 only.
    [ "$(uname -m)" = x86_64 ] || fail "unsupported architecture"
    grep -q '^Rocky Linux release 9\.' /etc/rocky-release || fail "base OS is not Rocky Linux 9"

    # R's utils package runs /usr/bin/which when it loads, and the Rocky 9 base
    # image has no which. Install only that package from Rocky 9 BaseOS, with
    # the DNF cache in the workspace.
    dnf --assumeyes --setopt=cachedir="$WORK/dnf-cache" --setopt=keepcache=0 \
        --setopt=install_weak_deps=False install which
    [ -x /usr/bin/which ] || fail "which was not installed"

    checkpoint 1_after_dnf

    # Miniforge from the conda-forge project's GitHub release (never Miniconda
    # or the Anaconda Distribution). SHA256 matches the published .sha256 file.
    # It is installed into the workspace and removed with it after use.
    curl --fail --location --retry 3 \
        --connect-timeout 30 --max-time 600 \
        --output "$WORK/src/Miniforge3-26.7.2-0-Linux-x86_64.sh" \
        https://github.com/conda-forge/miniforge/releases/download/26.7.2-0/Miniforge3-26.7.2-0-Linux-x86_64.sh
    printf '%s  %s\n' \
        281b0ac7d550802efc81af633225a5e6116d29ae72f3ab4eae7168c3931a4c05 \
        "$WORK/src/Miniforge3-26.7.2-0-Linux-x86_64.sh" | sha256sum --check -
    checkpoint 2_before_miniforge
    bash "$WORK/src/Miniforge3-26.7.2-0-Linux-x86_64.sh" -b -p "$WORK/miniforge"
    checkpoint 3_after_miniforge

    # conda configuration, package cache, and environments list stay in the
    # workspace. Only conda-forge and bioconda are configured, defaults is
    # empty, and every command still passes --override-channels.
    export CONDARC="$WORK/condarc"
    export CONDA_PKGS_DIRS="$WORK/conda-pkgs"
    printf '%s\n' \
        'channels:' \
        '  - conda-forge' \
        '  - bioconda' \
        'default_channels: []' \
        'channel_priority: strict' \
        'auto_update_conda: false' \
        'notify_outdated_conda: false' \
        'report_errors: false' \
        > "$CONDARC"
    CONDA="$WORK/miniforge/bin/conda"

    # Create the /opt/bio environment from exact package versions.
    "$CONDA" create --yes --prefix /opt/bio \
        --override-channels --channel conda-forge --channel bioconda \
        --strict-channel-priority \
        r-base=4.5.3 \
        bioconductor-clusterprofiler=4.18.4 \
        bioconductor-annotationdbi=1.72.0 \
        bioconductor-go.db=3.22.0 \
        bioconductor-enrichplot=1.30.5 \
        r-ggplot2=4.0.3

    checkpoint 4_after_conda_create

    # Record the exact package set with SHA256 values, then check that every
    # package came from conda-forge or bioconda.
    mkdir -p /opt/bio/share/bx-functional-enrichment
    "$CONDA" list --prefix /opt/bio --explicit --sha256 > /opt/bio/share/bx-functional-enrichment/conda-explicit.txt
    awk '
        /^https?:/ && $0 !~ /^https:\/\/conda\.anaconda\.org\/(conda-forge|bioconda)\// { print "Package from a disallowed channel: " $0 > "/dev/stderr"; bad = 1 }
        END { exit bad }
    ' /opt/bio/share/bx-functional-enrichment/conda-explicit.txt || fail "package from a disallowed channel"
    "$CONDA" list --prefix /opt/bio > /opt/bio/share/bx-functional-enrichment/conda-packages.txt
    cp /etc/rocky-release /opt/bio/share/bx-functional-enrichment/base-os-release.txt
    rpm -qa --qf '%{NAME}\t%{VERSION}-%{RELEASE}\n' | sort > /opt/bio/share/bx-functional-enrichment/rocky-packages.tsv
    /opt/bio/bin/R --version | head -n 1 > /opt/bio/share/bx-functional-enrichment/r-version.txt
    grep -F 'R version 4.5.3' /opt/bio/share/bx-functional-enrichment/r-version.txt

    checkpoint 5_before_cleanup
    # Remove only the exact workspace created above; stop on any doubt.
    # Each check is a separate command so that set -e cannot skip a failure.
    [ "$WORK" = /__closha_build/work ] || fail "unexpected workspace path"
    [ ! -L "$BUILD_ROOT" ] || fail "parent is a symlink"
    [ ! -L "$WORK" ] || fail "workspace is a symlink"
    [ -d "$WORK" ] || fail "workspace is missing"
    [ "$(realpath -e -- "$WORK")" = "$WORK" ] || fail "canonical path changed"
    [ "$(stat -c %d -- "$WORK")" = "$(stat -c %d -- /)" ] || fail "workspace is on another filesystem"
    # Under the fakeroot command (production builds by an account without
    # /etc/subuid entries), a stale fakeroot record can report a directory as
    # a regular file. A production build showed this for miniforge/pkgs: rm
    # and Python's shutil.rmtree both called unlink on it and stopped with
    # "Is a directory". If rm fails, the rest is removed with the base
    # image's Python, which decides by the kernel's answer instead of stat:
    # it unlinks each entry and only on EISDIR opens it as a directory
    # (O_NOFOLLOW, same filesystem as the workspace), empties it, and removes
    # it with rmdir. Symbolic links are removed, never followed.
    if ! rm -rf --one-file-system -- "$WORK"; then
        echo "rm could not remove all of $WORK; retrying with python3" >&2
        /usr/bin/env python3 - "$WORK" <<'PYCLEAN' || fail "python3 could not remove the workspace"
import os, sys
# Remove the workspace without trusting file types from stat: under the
# fakeroot command a stale record can report a directory as a file. Each
# entry is unlinked; only when the kernel answers EISDIR is it opened as a
# directory (no symlink following, same device as the workspace), emptied,
# and removed with rmdir.
root = sys.argv[1]
dir_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
root_fd = os.open(root, dir_flags)
root_dev = os.fstat(root_fd).st_dev
removed = [0, 0]

def empty(dir_fd, where):
    for name in os.listdir(dir_fd):
        try:
            os.unlink(name, dir_fd=dir_fd)
            removed[0] += 1
            continue
        except FileNotFoundError:
            continue
        except IsADirectoryError:
            pass
        fd = os.open(name, dir_flags, dir_fd=dir_fd)
        try:
            if os.fstat(fd).st_dev != root_dev:
                sys.exit("not removing a different filesystem: %s/%s" % (where, name))
            empty(fd, where + "/" + name)
        finally:
            os.close(fd)
        os.rmdir(name, dir_fd=dir_fd)
        removed[1] += 1

try:
    empty(root_fd, root)
finally:
    os.close(root_fd)
os.rmdir(root)
print("python3 removed %d files and %d directories" % tuple(removed), file=sys.stderr)
PYCLEAN
    fi
    [ ! -e "$WORK" ] || fail "workspace could not be removed"
    rmdir -- "$BUILD_ROOT"

%runscript
    exec /opt/bio/bin/Rscript "$@"

%test
    set -eu
    export PATH=/opt/bio/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C.UTF-8

    # The build runs %test separately from %post, again with the host /tmp and
    # /var/tmp bound (mount tmp = yes), and R and Python create temporary
    # files there. When running as root (a root or fakeroot build), cover both,
    # and /dev/shm when present, with private tmpfs mounts first; if mounting
    # fails, the build stops.
    # Unprivileged runtime checks cannot mount and skip this step.
    if [ "$(id -u)" = 0 ]; then
        mount -t tmpfs -o mode=1777,nosuid,nodev closha-tmp /tmp
        mount -t tmpfs -o mode=1777,nosuid,nodev closha-vartmp /var/tmp
        [ "$(stat -f -c %T /tmp)" = tmpfs ] || { echo "/tmp is not private" >&2; exit 1; }
        [ "$(stat -f -c %T /var/tmp)" = tmpfs ] || { echo "/var/tmp is not private" >&2; exit 1; }
        if [ -d /dev/shm ]; then
            mount -t tmpfs -o mode=1777,nosuid,nodev closha-shm /dev/shm
            awk '$5 == "/dev/shm" { s = $0 } END { exit !(s ~ / - tmpfs closha-shm /) }' /proc/self/mountinfo ||
                { echo "/dev/shm is not private" >&2; exit 1; }
        fi
    fi

    for cmd in R Rscript; do
        [ "$(command -v "$cmd")" = "/opt/bio/bin/$cmd" ]
    done
    [ -x /usr/bin/which ]

    R --version | head -n 1 | grep -F 'R version 4.5.3'

    # Attach packages in the script order, then check every pkg::function
    # and every unqualified function the script uses. GO.db must resolve a term offline.
    Rscript --no-init-file -e '
        pkgs <- c("clusterProfiler", "AnnotationDbi", "enrichplot", "ggplot2",
                  "GO.db")
        for (p in pkgs) suppressPackageStartupMessages(library(p, character.only = TRUE))
        if (!startsWith(as.character(packageVersion("clusterProfiler")), "4.18.")) {
            stop("unexpected clusterProfiler version: ", packageVersion("clusterProfiler"))
        }
        if (!startsWith(as.character(packageVersion("GO.db")), "3.22.")) {
            stop("unexpected GO.db version: ", packageVersion("GO.db"))
        }
        if (!startsWith(as.character(packageVersion("enrichplot")), "1.30.")) {
            stop("unexpected enrichplot version: ", packageVersion("enrichplot"))
        }
        used <- c(
            "clusterProfiler::enricher", "clusterProfiler::enrichGO",
            "AnnotationDbi::loadDb", "AnnotationDbi::keytypes",
            "AnnotationDbi::keys", "AnnotationDbi::Ontology",
            "AnnotationDbi::Term", "enrichplot::dotplot",
            "ggplot2::ggtitle", "ggplot2::ggsave",
            "graphics::barplot"
        )
        for (u in used) {
            x <- strsplit(u, "::", fixed = TRUE)[[1]]
            invisible(getExportedValue(x[1], x[2]))
        }
        unqualified <- c(
            "globalCallingHandlers"
        )
        missing <- unqualified[!vapply(unqualified, exists, logical(1))]
        if (length(missing) > 0) {
            stop("functions not found on the search path: ", paste(missing, collapse = ", "))
        }
        term <- AnnotationDbi::Term("GO:0015979")
        if (!identical(unname(term), "photosynthesis")) stop("GO.db term lookup failed: ", term)
        pdf(NULL)
        plot(1)
        invisible(dev.off())
        cat("clusterProfiler", as.character(packageVersion("clusterProfiler")), "\n")
    '

    # Every recorded package URL must come from conda-forge or bioconda.
    awk '
        /^https?:/ && $0 !~ /^https:\/\/conda\.anaconda\.org\/(conda-forge|bioconda)\// { print "Package from a disallowed channel: " $0 > "/dev/stderr"; bad = 1 }
        END { exit bad }
    ' /opt/bio/share/bx-functional-enrichment/conda-explicit.txt
    [ "$(grep -c -E '^https://' /opt/bio/share/bx-functional-enrichment/conda-explicit.txt)" -gt 0 ]

    # The build workspace must not remain in the image.
    if [ -e /__closha_build ]; then
        echo 'Build workspace /__closha_build remains in the image' >&2
        exit 1
    fi

    echo 'R 4.5.3 / Bioconductor 3.22 (bioconda): bx_functional_enrichment runtime dependency checks passed.'

%help
    CLOSHA functional enrichment environment: R 4.5.3 + Bioconductor 3.22
    (clusterProfiler, AnnotationDbi, GO.db, enrichplot, ggplot2).
    Base OS: Rocky Linux 9. Tools are installed in /opt/bio from conda-forge and
    bioconda with Miniforge; no Anaconda Inc. repository or Miniconda is used.

    The CLOSHA build system builds this DEF with its fixed Slurm job (policy
    section 6.2), on an internet-connected x86_64 node, without extra binds:
        apptainer build bx_functional_enrichment.1.0.sif bx_functional_enrichment.1.0.def
    It must pass both as root and with fakeroot.

    Store the SIF, Apptainer cache, and build temporary files in an approved host
    build workspace. APPTAINER_CACHEDIR and APPTAINER_TMPDIR select the cache and
    temporary directories. Container cleanup must never target host-backed binds.
    Build from a shell without APPTAINER_* or SINGULARITY_* bind variables.

    Check the image:
        apptainer test --cleanenv bx_functional_enrichment.1.0.sif

    functional_enrichment.1.0.R is supplied externally through approved runtime binds.
    This DEF does not run it during image construction:
        apptainer exec bx_functional_enrichment.1.0.sif Rscript functional_enrichment.1.0.R key=value ...

    Give the OrgDb file saved by tools/download_orgdb.R (orgdb_file) or a
    gene-to-GO table (go_table). The image holds no species data and the
    analysis needs no network access.
    The script removes previous output except logs/, so output_dir must be
    separate from the inputs and their parents.
    Writable runtime binds can expose host data to the analysis script.
    Runtime analysis requires no network access.
